{
  "name": "vue3-crud-hooks",
  "version": "1.2.0",
  "description": "基于 Vue 3 和 Element Plus 的 CRUD 工具库",
  "type": "module",
  "author": "YongHangPu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YongHangPu/vue3-crud-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/YongHangPu/vue3-crud-hooks/issues"
  },
  "homepage": "https://github.com/YongHangPu/vue3-crud-hooks",
  "keywords": [
    "vue-hooks",
    "crud-hooks",
    "use-table",
    "use-form",
    "pagination",
    "dialog",
    "modal",
    "search",
    "table-height",
    "use-table-height",
    "element-plus-crud"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "style": "./dist/vue3-crud-hooks.css",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/vue3-crud-hooks.css",
    "./useTablePage": {
      "types": "./dist/hooks/useTablePage.d.ts",
      "import": "./dist/useTablePage.mjs",
      "require": "./dist/useTablePage.cjs"
    },
    "./useFormDialog": {
      "types": "./dist/hooks/useFormDialog.d.ts",
      "import": "./dist/useFormDialog.mjs",
      "require": "./dist/useFormDialog.cjs"
    },
    "./useCrudPage": {
      "types": "./dist/hooks/useCrudPage.d.ts",
      "import": "./dist/useCrudPage.mjs",
      "require": "./dist/useCrudPage.cjs"
    },
    "./useDataTransform": {
      "types": "./dist/hooks/useDataTransform.d.ts",
      "import": "./dist/useDataTransform.mjs",
      "require": "./dist/useDataTransform.cjs"
    },
    "./useMessage": {
      "types": "./dist/hooks/useMessage.d.ts",
      "import": "./dist/useMessage.mjs",
      "require": "./dist/useMessage.cjs"
    },
    "./package.json": "./package.json",
    "./useTableHeight": {
      "types": "./dist/hooks/useTableHeight.d.ts",
      "import": "./dist/useTableHeight.mjs",
      "require": "./dist/useTableHeight.cjs"
    },
    "./CustomTable": {
      "types": "./dist/components/CustomTable.vue.d.ts",
      "import": "./dist/CustomTable.mjs",
      "require": "./dist/CustomTable.cjs"
    },
    "./Pagination": {
      "types": "./dist/components/Pagination.vue.d.ts",
      "import": "./dist/Pagination.mjs",
      "require": "./dist/Pagination.cjs"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:zh": "pnpm test:coverage && node ./scripts/coverage-zh.mjs",
    "sync:changelog": "node ./scripts/sync-changelog.mjs",
    "docs:dev": "node ./scripts/sync-changelog.mjs && vitepress dev docs",
    "docs:build": "node ./scripts/sync-changelog.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "element-plus": "^2.0.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "await-to-js": "^3.0.0",
    "lodash-unified": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitepress-demo-preview/component": "^2.6.2",
    "@vitepress-demo-preview/plugin": "^1.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/language-core": "^3.3.9",
    "@vue/test-utils": "^2.4.11",
    "element-plus": "^2.14.4",
    "jsdom": "^30.0.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
